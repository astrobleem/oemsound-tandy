@ECHO OFF
PATH=C:\BIN
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od TSOUND.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /Mx SHIM.ASM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @TSOUND.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /W3 /Od DRVTEST.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @DRVTEST.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /W3 /Od INTRUD.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @INTRUD.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
EXIT
