@ECHO OFF
SET PATH=C:\BIN;C:\DOS
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
SET TMP=D:\TMP
IF NOT EXIST D:\TMP\NUL MD D:\TMP
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od TIMECLK.C > RAWBUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /MX CLOCK.ASM; >> RAWBUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /MX WINHOOK.ASM; >> RAWBUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @TIMECLK.RSP >> RAWBUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> RAWBUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> RAWBUILD.LOG
:END
