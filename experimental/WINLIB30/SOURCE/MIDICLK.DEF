LIBRARY MIDICLK
DESCRIPTION 'Private generation-safe timestamped PSG MIDI deadline transport'
EXETYPE WINDOWS
CODE MOVEABLE DISCARDABLE PRELOAD
DATA FIXED SINGLE PRELOAD
HEAPSIZE 0
EXPORTS
 MDOPEN=MDOpen @1
 MDPUSH=MDPush @2
 MDCOMMIT=MDCommit @3
 MDSTART=MDStart @4
 MDPUMP=MDPump @5
 MDPAUSE=MDPause @6
 MDRESUME=MDResume @7
 MDRESET=MDReset @8
 MDCLOSE=MDClose @9
 MDSTATUS=MDStatus @10
 WEP @11 RESIDENTNAME
 MDSEED=MDSeed @12
 MDTIMING=MDTiming @13
 MDVERSION=MDVersion @14
 MDCLOCK=MDClock @15
 MDVOICEMODE=MDVoiceMode @16
 MDDEBUG=MDDebug @17
 MDBeginLive @18
