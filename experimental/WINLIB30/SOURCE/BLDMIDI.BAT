@ECHO OFF
SET PATH=C:\BIN;C:\DOS
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
SET TMP=D:\TMP
IF NOT EXIST D:\TMP\NUL MD D:\TMP
ECHO BEGIN MIDI THREE DLL BUILD > BUILD.LOG
ECHO C6 TIMECLK >> BUILD.LOG
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od TIMECLK.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO C6 MIDICLK >> BUILD.LOG
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od MIDICLK.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO C6 MIDISYN >> BUILD.LOG
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od MIDISYN.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO C6 INSTR >> BUILD.LOG
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od INSTR.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO C6 MCITNDY >> BUILD.LOG
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od MCITNDY.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO C6 MCIPSG >> BUILD.LOG
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od MCIPSG.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO C6 SMF >> BUILD.LOG
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od SMF.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /MX CLOCK.ASM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /MX WINHOOK.ASM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /MX ENTRY.ASM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @TIMECLK.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @MIDICLK.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD @MCITNDY.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS MIDI THREE DLL BUILD >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL MIDI THREE DLL BUILD >> BUILD.LOG
:END
