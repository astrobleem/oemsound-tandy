LIBRARY MCITNDY
DESCRIPTION 'Private bounded MCI sequencer; 55ms task service'
EXETYPE WINDOWS
CODE FIXED PRELOAD
DATA FIXED PRELOAD SINGLE
HEAPSIZE 0
EXPORTS
 MCICOMMAND=MciCommand @701
 MCISTRING=MciString @702
 MCIERROR=MciError @706
 MCIPUMP=MciPump @900
 MCIWND=MciWnd @903
 MCIDEBUG=MciDebug @904
 MCIBANK=MciBank @905
 WEP @1
