@ECHO OFF
SET PATH=C:\BIN;C:\DOS
SET INCLUDE=C:\INCLUDE
SET LIB=C:\LIB
CL /nologo /c /G0 /AS /W3 /Od TPLAY.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /MX DOSSTAT.ASM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
C:\BIN\LINK4 /NOE /NOD /CPARMAXALLOC:1024 @TPLAY.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
EXIT
