@ECHO OFF
SET PATH=C:\BIN;C:\DOS
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
SET TMP=D:\TMP
IF NOT EXIST D:\TMP\NUL MD D:\TMP
ECHO BEGIN NATIVE PLAYER BUILD > BUILD.LOG
ECHO C6 MINIPLAY >> BUILD.LOG
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od MINIPLAY.C >> BUILD.LOG
