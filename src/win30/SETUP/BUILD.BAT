@ECHO OFF
SET PATH=C:\BIN;C:\DOS
SET INCLUDE=C:\INCLUDE
SET LIB=C:\LIB
CL /nologo /c /G0 /AS /W3 /Od SETUP.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD /STACK:8192 @SETUP.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
COPY SETUP.EXE SETUPPRD.EXE >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /DSETUP_TEST /G0 /AS /W3 /Od SETUP.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD /STACK:8192 @SETUP.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
COPY SETUP.EXE SETUPTST.EXE >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
COPY SETUPPRD.EXE SETUP.EXE >> BUILD.LOG
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
EXIT
