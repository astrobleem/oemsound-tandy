@ECHO OFF
PATH=C:\BIN;C:\DOS
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
CL /nologo /c /G0 /Gw /AS /W3 /Od EFFECTS.C FXCORE.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @EFFECTS.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
SET INCLUDE=C:\INCLUDE
CL /nologo /c /G0 /AS /W3 /Od FXSTART.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /MX DOSSTAT.ASM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD /CPARMAXALLOC:1024 @FXSTART.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
