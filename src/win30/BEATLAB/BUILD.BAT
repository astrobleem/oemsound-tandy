@ECHO OFF
PATH=C:\BIN;C:\DOS
SET INCLUDE=C:\DDK\286\INC;C:\INCLUDE
SET LIB=C:\LIB
CL /nologo /c /G0 /Gw /AS /W3 /Od BEATS.C BEATPAT.C BEATEXP.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @BEATS.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /Gs /AS /W3 /Od MIDIMAP.C INSTR.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /MX ENTRY.ASM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD @MIDIMAP.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
CL /nologo /c /G0 /Gw /AS /W3 /Od MMLFIDL.C MMLCORE.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /MAP /NOE /NOD @MMLFIDL.RSP >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
