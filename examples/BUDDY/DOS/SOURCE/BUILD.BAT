@echo off
PATH=C:\BIN
SET INCLUDE=C:\INCLUDE
SET LIB=C:\LIB
CL /nologo /c /G0 /AS /W3 /Os DOSPLAY.C > BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
MASM /W2 HARDWARE.ASM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
LINK4 /NOE /NOD /MAP /STACK:4096 DOSPLAY+HARDWARE,DOSPLAY,DOSPLAY,SLIBCE; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO FAIL
ECHO PASS >> BUILD.LOG
GOTO END
:FAIL
ECHO FAIL >> BUILD.LOG
:END
EXIT
